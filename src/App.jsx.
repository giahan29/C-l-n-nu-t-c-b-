class SoundEffectsManager {
  private ctx: AudioContext | null = null;
  private isMuted: boolean = false;
  private volume: number = 0.8;
  private ambientGain: GainNode | null = null;
  private isAmbientPlaying: boolean = false;

  private initContext() {
    if (!this.ctx) {
      const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      this.ctx = new AudioCtx();
    }
    if (this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  public setMuted(muted: boolean) {
    this.isMuted = muted;
    if (this.ambientGain) {
      this.ambientGain.gain.setValueAtTime(muted ? 0 : 0.08 * this.volume, this.ctx?.currentTime || 0);
    }
  }

  // Âm đớp mồi "Nom-Nom-Chomp" hài hước
  public playChomp(variant: number = 0) {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;

    const t = this.ctx.currentTime;
    const masterGain = this.ctx.createGain();
    masterGain.gain.setValueAtTime(0.5 * this.volume, t);
    masterGain.connect(this.ctx.destination);

    const baseFreq = 260 + (variant % 3) * 60 + Math.random() * 40;

    const osc1 = this.ctx.createOscillator();
    const g1 = this.ctx.createGain();
    osc1.type = 'triangle';
    osc1.frequency.setValueAtTime(baseFreq * 1.5, t);
    osc1.frequency.exponentialRampToValueAtTime(baseFreq * 0.7, t + 0.08);
    g1.gain.setValueAtTime(0.7, t);
    g1.gain.exponentialRampToValueAtTime(0.01, t + 0.08);
    osc1.connect(g1);
    g1.connect(masterGain);
    osc1.start(t);
    osc1.stop(t + 0.09);

    const osc2 = this.ctx.createOscillator();
    const g2 = this.ctx.createGain();
    osc2.type = 'sine';
    osc2.frequency.setValueAtTime(baseFreq * 2.2, t + 0.07);
    osc2.frequency.exponentialRampToValueAtTime(baseFreq * 0.9, t + 0.16);
    g2.gain.setValueAtTime(0.01, t);
    g2.gain.setValueAtTime(0.9, t + 0.07);
    g2.gain.exponentialRampToValueAtTime(0.01, t + 0.17);
    osc2.connect(g2);
    g2.connect(masterGain);
    osc2.start(t + 0.07);
    osc2.stop(t + 0.18);
  }

  public playBloop() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sine';
    const startFreq = 400 + Math.random() * 200;
    osc.frequency.setValueAtTime(startFreq, t);
    osc.frequency.exponentialRampToValueAtTime(startFreq * 2.3, t + 0.1);
    g.gain.setValueAtTime(0.35 * this.volume, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.12);
    osc.connect(g);
    g.connect(this.ctx.destination);
    osc.start(t);
    osc.stop(t + 0.13);
  }

  public playCorrect() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const notes = [523.25, 659.25, 783.99, 1046.5]; // C5, E5, G5, C6
    const t = this.ctx.currentTime;
    notes.forEach((freq, idx) => {
      if (!this.ctx) return;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      const noteTime = t + idx * 0.08;
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, noteTime);
      g.gain.setValueAtTime(0.4 * this.volume, noteTime);
      g.gain.exponentialRampToValueAtTime(0.01, noteTime + 0.3);
      osc.connect(g);
      g.connect(this.ctx.destination);
      osc.start(noteTime);
      osc.stop(noteTime + 0.32);
    });
  }

  public playWrong() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(320, t);
    osc.frequency.exponentialRampToValueAtTime(140, t + 0.3);
    osc.frequency.exponentialRampToValueAtTime(90, t + 0.6);
    g.gain.setValueAtTime(0.5 * this.volume, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.65);
    osc.connect(g);
    g.connect(this.ctx.destination);
    osc.start(t);
    osc.stop(t + 0.7);
  }

  public playLevelUp() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const freqs = [392, 523.25, 659.25, 783.99, 1046.5];
    freqs.forEach((f, i) => {
      if (!this.ctx) return;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      const start = t + i * 0.07;
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(f, start);
      g.gain.setValueAtTime(0.45 * this.volume, start);
      g.gain.exponentialRampToValueAtTime(0.01, start + 0.4);
      osc.connect(g);
      g.connect(this.ctx.destination);
      osc.start(start);
      osc.stop(start + 0.45);
    });
  }

  public playUrchinHit() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(420, t);
    osc.frequency.exponentialRampToValueAtTime(110, t + 0.25);
    g.gain.setValueAtTime(0.5 * this.volume, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.26);
    osc.connect(g);
    g.connect(this.ctx.destination);
    osc.start(t);
    osc.stop(t + 0.27);
  }

  public playJellyfishZap() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(800, t);
    osc.frequency.linearRampToValueAtTime(1400, t + 0.08);
    osc.frequency.linearRampToValueAtTime(400, t + 0.2);
    g.gain.setValueAtTime(0.45 * this.volume, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.22);
    osc.connect(g);
    g.connect(this.ctx.destination);
    osc.start(t);
    osc.stop(t + 0.23);
  }

  public playMineExplosion() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(140, t);
    osc.frequency.exponentialRampToValueAtTime(35, t + 0.45);
    g.gain.setValueAtTime(0.7 * this.volume, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.48);
    osc.connect(g);
    g.connect(this.ctx.destination);
    osc.start(t);
    osc.stop(t + 0.5);
  }

  public playQuizFound() {
    if (this.isMuted) return;
    this.initContext();
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    [659.25, 783.99, 1046.5, 1318.5].forEach((freq, idx) => {
      if (!this.ctx) return;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      const startTime = t + idx * 0.06;
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, startTime);
      g.gain.setValueAtTime(0.4 * this.volume, startTime);
      g.gain.exponentialRampToValueAtTime(0.01, startTime + 0.28);
      osc.connect(g);
      g.connect(this.ctx.destination);
      osc.start(startTime);
      osc.stop(startTime + 0.3);
    });
  }

  public startAmbient() {
    if (this.isAmbientPlaying) return;
    this.initContext();
    if (!this.ctx) return;
    this.isAmbientPlaying = true;
    this.ambientGain = this.ctx.createGain();
    this.ambientGain.gain.setValueAtTime(this.isMuted ? 0 : 0.08 * this.volume, this.ctx.currentTime);
    this.ambientGain.connect(this.ctx.destination);

    const bubbleLoop = () => {
      if (!this.isAmbientPlaying || !this.ctx || !this.ambientGain) return;
      if (!this.isMuted && Math.random() < 0.6) {
        const t = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const g = this.ctx.createGain();
        osc.type = 'sine';
        const freq = 300 + Math.random() * 350;
        osc.frequency.setValueAtTime(freq, t);
        osc.frequency.exponentialRampToValueAtTime(freq * 1.6, t + 0.15);
        g.gain.setValueAtTime(0.04 * this.volume, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.16);
        osc.connect(g);
        g.connect(this.ambientGain);
        osc.start(t);
        osc.stop(t + 0.17);
      }
      setTimeout(bubbleLoop, 800 + Math.random() * 1200);
    };
    bubbleLoop();
  }

  // Phát âm tiếng Anh bản địa bằng SpeechSynthesis API
  public speakWord(text: string) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'en-US';
    utterance.rate = 0.9;
    utterance.pitch = 1.05;
    window.speechSynthesis.speak(utterance);
  }

  public playClick() {
    this.playBloop();
  }
}

