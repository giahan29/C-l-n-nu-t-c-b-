  onAnswer: (isCorrect: boolean) => void;
  livesRemaining: number;
}

export const QuestionModal: React.FC<QuestionModalProps> = ({
  question,
  preyName,
  preySrc,
  onAnswer,
}) => {
  const [selectedIndex, setSelectedIndex] = useState<number | null>(null);
  const [hasSubmitted, setHasSubmitted] = useState<boolean>(false);
  const [timeLeft, setTimeLeft] = useState<number>(20);

  useEffect(() => {
    soundManager.playQuizFound();
    if (question.englishPhrase) {
      setTimeout(() => soundManager.speakWord(question.englishPhrase!), 500);
    }
  }, [question]);

  useEffect(() => {
    if (hasSubmitted) return;
    const interval = setInterval(() => {
      setTimeLeft((prev) => {
        if (prev <= 1) {
          clearInterval(interval);
          setHasSubmitted(true);
          soundManager.playWrong();
          return 0;
        }
        return prev - 1;
      });
    }, 1000);
    return () => clearInterval(interval);
  }, [hasSubmitted]);

  const handleSelectOption = (index: number) => {
    if (hasSubmitted) return;
    setSelectedIndex(index);
    setHasSubmitted(true);
    const isCorrect = index === question.correctIndex;
    if (isCorrect) {
      soundManager.playCorrect();
      confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
    } else {
      soundManager.playWrong();
    }
  };

  const isCorrect = selectedIndex === question.correctIndex;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
      <div className="relative w-full max-w-xl bg-gradient-to-b from-sky-900/90 via-blue-950/95 to-indigo-950 border-4 border-amber-400 rounded-3xl shadow-2xl p-6 text-white">
        <div className="flex items-center gap-4 pb-4 border-b border-sky-700/50">
          <img src={preySrc} alt={preyName} className="w-16 h-16 object-contain animate-bounce" />
          <div className="flex-1">
            <div className="flex items-center justify-between">
              <span className="text-xs font-bold text-amber-300">⭐ Cá Thông Thái!</span>
              <span className="text-xs font-bold text-emerald-300">{timeLeft}s</span>
            </div>
            <h3 className="text-lg font-black">{preyName} mang câu đố!</h3>
          </div>
        </div>

        <div className="my-4 p-4 bg-sky-950/60 rounded-2xl border border-sky-500/30">
          {question.englishPhrase && (
            <button
              onClick={() => soundManager.speakWord(question.englishPhrase!)}
              className="text-xs text-amber-300 flex items-center gap-1 mb-2 hover:underline cursor-pointer"
            >
              <Volume2 className="w-4 h-4" /> Nghe phát âm: "{question.englishPhrase}"
            </button>
          )}
          <p className="font-bold text-base">{question.question}</p>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
          {question.options.map((option, idx) => (
            <button
              key={idx}
              disabled={hasSubmitted}
              onClick={() => handleSelectOption(idx)}
              className={`p-3 rounded-xl border text-left font-semibold cursor-pointer ${
                hasSubmitted
                  ? idx === question.correctIndex
                    ? 'bg-emerald-600 border-emerald-400'
                    : idx === selectedIndex
                    ? 'bg-rose-600 border-rose-400'
                    : 'bg-slate-900/50 border-slate-700 opacity-50'
                  : 'bg-sky-900/40 hover:bg-sky-800 border-sky-600'
              }`}
            >
              {['A', 'B', 'C', 'D'][idx]}. {option}
            </button>
          ))}
        </div>

        {hasSubmitted && (
          <div className="p-3 bg-slate-900/80 rounded-xl mb-4 text-xs text-sky-100">
            <strong>Giải thích:</strong> {question.explanation}
          </div>
        )}

        {hasSubmitted && (
          <button
            onClick={() => onAnswer(isCorrect)}
            className="w-full py-3 bg-amber-400 text-slate-950 rounded-xl font-black cursor-pointer hover:brightness-110 flex items-center justify-center gap-2"
          >
            Tiếp tục cuộc đi săn <ArrowRight className="w-4 h-4" />
          </button>
        )}
      </div>
    </div>
  );
};
import React, { useState, useCallback, useRef } from 'react';
import { GameCanvas } from './components/GameCanvas';
import { GameHUD } from './components/GameHUD';
import { QuestionModal } from './components/QuestionModal';
import { QuestionBankModal } from './components/QuestionBankModal';
import { CharacterSelectModal } from './components/CharacterSelectModal';
import { GameOverModal } from './components/GameOverModal';
import { Question, FishDefinition, GameDifficulty, Obstacle } from './types/game';
import { loadQuestions, saveQuestions } from './data/defaultQuestions';
import { FISH_DEFINITIONS } from './utils/imageLoader';
import { soundManager } from './utils/audio';

type GamePhase = 'select-character' | 'playing' | 'game-over';

export default function App() {
  const [questions, setQuestions] = useState<Question[]>(() => loadQuestions());
  const [isQuestionBankOpen, setIsQuestionBankOpen] = useState(false);
  const [selectedSharkId, setSelectedSharkId] = useState<string>('cute_baby_shark');
  const [difficulty, setDifficulty] = useState<GameDifficulty>('medium');
  const [gamePhase, setGamePhase] = useState<GamePhase>('select-character');

  const [score, setScore] = useState<number>(0);
  const [highScore, setHighScore] = useState<number>(0);
  const [level, setLevel] = useState<number>(1);
  const [growthProgress, setGrowthProgress] = useState<number>(0);
  const [lives, setLives] = useState<number>(3);
  const [boostStamina, setBoostStamina] = useState<number>(100);
  const [isFrenzyActive, setIsFrenzyActive] = useState<boolean>(false);
  const [isPaused, setIsPaused] = useState<boolean>(false);
  const [isMuted, setIsMuted] = useState<boolean>(false);

  const [activeQuestion, setActiveQuestion] = useState<Question | null>(null);
  const [caughtPrey, setCaughtPrey] = useState<{ name: string; src: string } | null>(null);

  const handleStartGame = () => {
    soundManager.startAmbient();
    setScore(0);
    setLevel(1);
    setGrowthProgress(0);
    setLives(3);
    setBoostStamina(100);
    setGamePhase('playing');
  };

  const handleQuizFishEaten = useCallback((preyDef: FishDefinition) => {
    if (questions.length === 0) return;
    const q = questions[Math.floor(Math.random() * questions.length)];
    setCaughtPrey({ name: preyDef.vietnameseName, src: preyDef.src });
    setActiveQuestion(q);
  }, [questions]);

  const handleAnswerQuestion = (isCorrect: boolean) => {
    if (isCorrect) {
      setScore((s) => s + 300);
      setIsFrenzyActive(true);
      setTimeout(() => setIsFrenzyActive(false), 6000);
    }
    setActiveQuestion(null);
    setCaughtPrey(null);
  };

  const handleObstacleHit = useCallback((type: Obstacle['type']) => {
    if (type === 'urchin' || type === 'mine') {
      setLives((prev) => {
        const remaining = prev - 1;
        if (remaining <= 0) setGamePhase('game-over');
        return remaining;
      });
    }
  }, []);

  return (
    <div className="relative w-screen h-screen overflow-hidden bg-slate-950 select-none">
      <GameCanvas
        selectedSharkId={selectedSharkId}
        isPaused={isPaused || !!activeQuestion || isQuestionBankOpen || gamePhase !== 'playing'}
        score={score}
        level={level}
        growthProgress={growthProgress}
        isFrenzyActive={isFrenzyActive}
        difficulty={difficulty}
        onUpdateScore={(d) => setScore((s) => s + d)}
        onUpdateGrowth={setGrowthProgress}
        onLevelUp={() => setLevel((l) => Math.min(4, l + 1))}
        onQuizFishEaten={handleQuizFishEaten}
        onFishEaten={() => {}}
        onObstacleHit={handleObstacleHit}
        boostStamina={boostStamina}
        onUpdateBoostStamina={setBoostStamina}
      />

      {gamePhase === 'playing' && (
        <GameHUD
          score={score}
          highScore={highScore}
          level={level}
          growthProgress={growthProgress}
          lives={lives}
          maxLives={3}
          boostStamina={boostStamina}
          isFrenzyActive={isFrenzyActive}
          isPaused={isPaused}
          isMuted={isMuted}
          englishStreak={0}
          difficulty={difficulty}
          onToggleDifficulty={() => setDifficulty((d) => (d === 'medium' ? 'hard' : 'medium'))}
          onTogglePause={() => setIsPaused((p) => !p)}
          onToggleMute={() => {
            setIsMuted(!isMuted);
            soundManager.setMuted(!isMuted);
          }}
          onOpenQuestionBank={() => setIsQuestionBankOpen(true)}
          characterName="Bé Cá Mập Cute"
        />
      )}

      {gamePhase === 'select-character' && (
        <CharacterSelectModal
          selectedSharkId={selectedSharkId}
          difficulty={difficulty}
          onSelectShark={setSelectedSharkId}
          onChangeDifficulty={setDifficulty}
          onStartGame={handleStartGame}
          onOpenQuestionBank={() => setIsQuestionBankOpen(true)}
        />
      )}

      {gamePhase === 'game-over' && (
        <GameOverModal
          score={score}
          highScore={highScore}
          level={level}
          fishesEaten={0}
          questionsAnswered={0}
          questionsCorrect={0}
          onRestart={handleStartGame}
          onOpenQuestionBank={() => setIsQuestionBankOpen(true)}
          onChangeCharacter={() => setGamePhase('select-character')}
        />
      )}

      {activeQuestion && caughtPrey && (
        <QuestionModal
          question={activeQuestion}
          preyName={caughtPrey.name}
          preySrc={caughtPrey.src}
          onAnswer={handleAnswerQuestion}
          livesRemaining={lives}
        />
      )}

      {isQuestionBankOpen && (
        <QuestionBankModal
          questions={questions}
          onSaveQuestions={(q) => {
            setQuestions(q);
            saveQuestions(q);
          }}
          onClose={() => setIsQuestionBankOpen(false)}
          onPreviewQuestion={(q) => {
            setActiveQuestion(q);
            setCaughtPrey({ name: 'Cá Sáp Xanh Nhí', src: '/assets/aistudio/image_722e59fa.png' });
          }}
        />
      )}
    </div>
  );
}
